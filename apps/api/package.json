{
  "name": "@raahi/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/node-server.ts",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/node-server.ts",
    "start": "tsx src/node-server.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:pull": "prisma db pull --force",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:migrate-dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:reset": "tsx --env-file-if-exists=../../.env prisma/reset.ts",
    "db:snapshot": "prisma db pull --force",
    "db:mysql-schema": "tsx --env-file-if-exists=../../.env prisma/mysql/apply-schema.ts",
    "db:mysql-init": "tsx --env-file-if-exists=../../.env prisma/mysql/init.ts",
    "test:express": "HTTP_TEST_TRANSPORT=express vitest run"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.11",
    "@ai-sdk/openai": "^4.0.9",
    "@ai-sdk/openai-compatible": "^3.0.6",
    "@ai-sdk/otel": "1.0.18",
    "@aws-sdk/client-s3": "^3.850.0",
    "@opentelemetry/api": "^1.9.1",
    "@raahi/agent-ui-catalog": "workspace:*",
    "@raahi/observability-contract": "workspace:*",
    "@sentry/node": "^10.65.0",
    "ai": "^7.0.18",
    "better-auth": "1.6.23",
    "express": "^5.3.0",
    "mongoose": "9.11.4",
    "tsx": "^4.19.2",
    "ws": "^8.22.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/express": "^5.0.6",
    "@types/mysql": "^2.15.27",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.18.2",
    "dotenv": "^17.4.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "mongodb-memory-server": "11.3.0",
    "prisma": "^7.8.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8",
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "mysql2": "^3.22.6",
    "pg": "^8.13.1"
  }
}
