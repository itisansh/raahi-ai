# Raahi AI — local Node/Mongo configuration
# Copy to .env if it does not already exist. Never commit real credentials or use VITE_* for keys.
# Account setup: README.md#configuration
# Restart API and web dev servers after editing.

# Local app and database
# Browser origin; Vite proxies /api to the Node API port below.
BASE_URL=http://localhost:5170
PORT=8780
WEB_PORT=5170
TRUSTED_ORIGINS=http://localhost:5170
# MongoDB replica set or Atlas; keep the connection URI private.
MONGO_URI=

# Authentication and email
# Replace with a random secret of at least 32 characters.
BETTER_AUTH_SECRET=
# Local verification codes are logged by the API.
EMAIL_PROVIDER=console
EMAIL_FROM=Raahi AI <noreply@localhost>

# Upload storage
STORAGE_BACKEND=fs
STORAGE_ROOT=uploads

# AI model — server only
# Gemini uses its OpenAI-compatible endpoint with AI_PROVIDER=openai.
# Set the endpoint, model ID and key privately; see the accounts guide.
AI_PROVIDER=openai
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=
AI_PROACTIVE_THRESHOLD=0.7
AI_MAX_TOOL_STEPS=16
AI_TELEMETRY_RECORD_CONTENT=false

# ElevenLabs — realtime transcription and spoken replies
# Both voice IDs are required for replies; one multilingual voice can fill both.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_VOICE_ID_HI=

# Places and routes — select osm, google or geoapify.
# OSM needs no key. Public services can be unavailable.
GEO_PROVIDER=geoapify
# Use an identifying application User-Agent with your contact URL in local .env.
GEO_OSM_USER_AGENT=RaahiAI/0.1 (https://your-domain.com; geo-agent)
# Optional endpoint, timeout and cache overrides:
# GEO_OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org
# GEO_OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
# GEO_OSM_OSRM_URL=https://router.project-osrm.org
# GEO_TIMEOUT_MS=12000
# GEO_CACHE_TTL_MS=1800000
# Google alternative: enable Places API (New) and Routes API with billing.
# GOOGLE_MAPS_API_KEY=

# Geoapify — places, medical search, geocoding and road routing.
# Required for GEO_PROVIDER=geoapify; obtain a free-plan key from myprojects.geoapify.com.
GEOAPIFY_API_KEY=

# Daily travel weather — empty disables.
# open-meteo opts into its free noncommercial API with CC BY 4.0 attribution.
# Commercial hosting requires a licensed provider/account integration.
TRAVEL_WEATHER_PROVIDER=

# Optional current features — uncomment only when configured.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM must be a verified sender when using Resend.
# OPENWEATHERMAP_API_KEY=
# UNSPLASH_ACCESS_KEY=
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=
# STREET_VIEW_PROVIDER=mapillary
# MAPILLARY_ACCESS_TOKEN=

# Deployment-only storage and hosting: see README.md#deployment.
# STORAGE_BACKEND=s3
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# WEB_DIST_PATH=auto
# Only explicitly verified reverse-proxy CIDRs.
# TRUST_PROXY_CIDRS=

# Optional free OpenRouter fallback for lightweight intent extraction only.
# Heavy planning and final replies stay on the primary (e.g. Gemini).
# Keep the key server-side. With no key, fallback is disabled.
# OPENROUTER_API_KEY=
# AI_FALLBACK_MODEL=openrouter/free
# AI_FALLBACK_COOLDOWN_SECONDS=60
