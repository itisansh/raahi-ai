# Local shared env. Copy to `.env` with `make env`.
# Put real credentials only in the ignored `.env`, never this example or VITE_*.
# For the voice/AI baseline, obtain ELEVENLABS_API_KEY and one AI_API_KEY.
# Other providers below are optional alternatives or deployment features.
# Account setup: docs/raahi/RAAHI_API_ACCOUNTS_AND_KEYS.md.

# Public origin used by the browser for API/auth calls. In dev this points at
# Vite, whose `/api` proxy forwards to the API on :8780.
BASE_URL=http://localhost:5170

# Node API: MongoDB through Mongoose. Use an isolated replica set or Atlas DB.
# Set the private URI only in the ignored root .env. Startup initializes indexes.
MONGO_URI=

# Legacy SQL settings: retained Worker runtime and M4 export/migration tooling.
# Node API does not use these settings or fall back to SQL.
DATABASE_PROVIDER=postgres
DATABASE_URL=postgres://opentrip:opentrip@localhost:5430/opentrip

# Better Auth. Secret must be >= 32 chars.
BETTER_AUTH_SECRET=dev-secret-change-me-0123456789abcdef
REALTIME_GRANT_SECRET=dev-realtime-secret-change-me-0123456789abcdef

# Origins allowed to call the API. Defaults to BASE_URL if omitted.
TRUSTED_ORIGINS=http://localhost:5170

# Optional: Google OAuth. Set both to enable "Sign in with Google".
# Redirect URI configured in Google Cloud Console must be:
#   {BASE_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional email for auth OTP (sign-up verification). Defaults to console
# logging so local OTP codes appear in the API process stdout.
# EMAIL_PROVIDER=console|resend
EMAIL_PROVIDER=console
EMAIL_FROM=OpenTrip <noreply@localhost>
# Required when EMAIL_PROVIDER=resend:
RESEND_API_KEY=

# Captcha (Cloudflare Turnstile). Use test keys for local dev; replace with real
# keys in production. Comment out CAPTCHA_PROVIDER to disable captcha entirely.
CAPTCHA_PROVIDER=cloudflare-turnstile
CAPTCHA_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Avatar storage. Local development uses the filesystem; production can select
# `s3` and provide the S3-compatible variables documented in operations.
STORAGE_BACKEND=fs
STORAGE_ROOT=uploads
# Optional production object storage; used only with STORAGE_BACKEND=s3.
# Obtain credentials from your S3-compatible storage provider (for example R2).
# Keep account-specific endpoints and bucket names in your private environment.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# API port.
PORT=8780

# Web dev server port.
WEB_PORT=5170

# OpenWeatherMap API key (used by the backend to proxy weather requests).
# Get a free key at https://openweathermap.org/api.
OPENWEATHERMAP_API_KEY=

# Unsplash access key for trip cover photos (create-trip wizard). Optional —
# without it, trip cards keep the decorative route SVG when no cover is set.
# https://unsplash.com/oauth/applications
UNSPLASH_ACCESS_KEY=

# Geo provider for agent place/route tools. Defaults to OpenStreetMap
# (Nominatim + Overpass + OSRM). Set GEO_PROVIDER=google and provide
# GOOGLE_MAPS_API_KEY to use Google Places + Routes instead.
GEO_PROVIDER=osm
GEO_OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org
GEO_OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
GEO_OSM_OSRM_URL=https://router.project-osrm.org
# Identifying User-Agent required by public OSM usage policies.
GEO_OSM_USER_AGENT=OpenTrip/0.1 (https://github.com/stvlynn/OpenTrip; geo-agent)
# GEO_TIMEOUT_MS=12000
# GEO_CACHE_TTL_MS=1800000
# Optional alternative to public OSM. Enable Places API (New) and Routes API
# in its Google Cloud project; billing is required. Restrict this server key to
# those APIs. Do not use browser-referrer restrictions for backend requests.
GOOGLE_MAPS_API_KEY=

# Airbnb lodging tools for the trip agent (openbnb-style in-process scrape).
# No API key required. Respects Airbnb robots.txt by default.
# LODGING_IGNORE_ROBOTS_TXT=false
# LODGING_DISABLE_GEOCODING=false
# LODGING_TIMEOUT_MS=30000
# LODGING_GEOCODE_USER_AGENT=OpenTrip/0.1 (https://github.com/stvlynn/OpenTrip; lodging-geocode)

# Trip agent (Vercel AI SDK). The agent is disabled unless both AI_MODEL and
# AI_API_KEY are set.
# - openai: leave AI_BASE_URL empty for the OpenAI API, or set an OpenAI-compatible URL
# - minimax: AI_PROVIDER=minimax; leave AI_BASE_URL empty for Anthropic-compatible
#   https://api.minimaxi.com/anthropic/v1 (…/anthropic also accepted; /v1 is required
#   for @ai-sdk/anthropic so thinking streams as separate reasoning parts)
AI_PROVIDER=openai
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=
# Gemini: create a key at https://aistudio.google.com/apikey and put it in
# AI_API_KEY (this app does not read GEMINI_API_KEY). Use AI_PROVIDER=openai
# with the provider's OpenAI-compatible endpoint in AI_BASE_URL and a supported
# model ID in AI_MODEL. See the accounts guide for the endpoint.
# Gemini tool calling/structured-output compatibility still needs live testing.

# Raahi speech input: server-only; never use a VITE_ prefix.
# Missing key leaves typed input available. Live Scribe verification is required.
ELEVENLABS_API_KEY=
# Minimum model confidence (0-1) before a proactive suggestion toast is created.
AI_PROACTIVE_THRESHOLD=0.7
# Upper bound on tool-call steps per chat generation.
AI_MAX_TOOL_STEPS=16
AI_TELEMETRY_RECORD_CONTENT=false

# Observability. Sentry is disabled when SENTRY_DSN is empty.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Operator-only historical Workers Logs query token. Do not sync to the Worker.
CLOUDFLARE_OBSERVABILITY_TOKEN=
# Platform-neutral street view. Unset provider to disable the capability.
STREET_VIEW_PROVIDER=
MAPILLARY_ACCESS_TOKEN=
# STREET_VIEW_TIMEOUT_MS=12000

# Planned Raahi travel adapters — NOT IMPLEMENTED; these names are reserved
# placeholders and currently have no runtime effect. No accounts needed yet.
# Geoapify: places, geocoding and nearby medical facilities.
# Obtain from https://myprojects.geoapify.com/ if this adapter is selected.
GEOAPIFY_API_KEY=
# openrouteservice: optional road/walking route estimates.
# Obtain from https://openrouteservice.org/ if this adapter is selected.
OPENROUTESERVICE_API_KEY=

# Future train/bus/flight/accommodation inventory: provider selection and
# authorized API access are pending. Add vendor-specific variables only after
# selection; no generic booking key or live inventory integration exists yet.
# ElevenLabs spoken summaries reuse ELEVENLABS_API_KEY (Text to Speech access).
# Copy voice IDs from your ElevenLabs voice library; choose Hindi/English-capable
# voices. Both are required to enable audio. They can be the same multilingual voice.
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_VOICE_ID_HI=
# No additional SDK is required for the server's HTTP TTS adapter.
# Default OSM routing needs no key. A future Open-Meteo
# adapter may support a keyless noncommercial endpoint, subject to its terms.

# Phase 7 daily travel forecasts. Empty disables; open-meteo opts into the free
# non-commercial API (CC BY 4.0 attribution). Commercial hosting needs a licensed
# provider/account integration; do not enable the free endpoint for commercial use.
TRAVEL_WEATHER_PROVIDER=

# Optional native Node same-origin frontend hosting (relative to apps/api).
# WEB_DIST_PATH=../web/dist
# Only explicitly verified reverse-proxy CIDRs; empty ignores forwarded IPs.
TRUST_PROXY_CIDRS=
