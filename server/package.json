    "@aws-sdk/client-s3": "^3.850.0",
    "@opentelemetry/api": "^1.9.1",
    "@raahi/agent-ui-catalog": "workspace:*",
    "@raahi/observability-contract": "workspace:*",
    "@sentry/node": "^10.65.0",
    "ai": "^7.0.18",
    "better-auth": "1.6.23",
    "express": "^5.3.0",
    "mongoose": "9.11.4",
    "tsx": "^4.19.2",
    "ws": "^8.22.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.18.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "mongodb-memory-server": "11.3.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
