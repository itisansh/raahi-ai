{
  "name": "raahi-ai",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Raahi AI — collaborative India travel planning.",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @raahi/web --filter @raahi/api --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm ui:check && pnpm build",
    "docs:check": "node scripts/docs-check.mjs",
    "ui:check": "node scripts/ui-check.mjs",
    "db:migrate": "pnpm --filter @raahi/api db:migrate",
    "db:seed": "pnpm --filter @raahi/api db:seed",
    "db:reset": "pnpm --filter @raahi/api db:reset",
    "db:generate": "pnpm --filter @raahi/api db:generate",
    "db:pull": "pnpm --filter @raahi/api db:pull",
    "db:studio": "pnpm --filter @raahi/api db:studio"
  },
  "devDependencies": {
    "@raahi/observability-contract": "workspace:*",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "esbuild",
      "@swc/core",
      "core-js",
      "core-js-pure"
    ]
  }
}
